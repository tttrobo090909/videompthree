<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMp3Row"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginBottom="2dp"
    android:background="@color/surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <!-- 0. 다중 선택 체크박스 (선택 모드일 때만 표시, 온전한 사각형 복구 및 원래 녹색 원복) -->
    <CheckBox
        android:id="@+id/cbRowSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:buttonTint="@color/secondary"
        android:clickable="false"
        android:focusable="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:visibility="gone" />

    <!-- 1. 파일 제목 (누르면 재생, 재생 중엔 파란 굵은 글자, 재생목록엔 밝은 하늘색 글자, 길면 왼쪽 흐름) -->
    <TextView
        android:id="@+id/tvMp3Title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:freezesText="true"
        android:gravity="center_vertical"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:text="음악 제목"
        android:textColor="@color/on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 2. 재생시간 -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:text="00:00"
        android:textColor="@color/on_surface_secondary"
        android:textSize="11sp" />

    <!-- 3. 공유 버튼 (18dp) -->
    <ImageButton
        android:id="@+id/btnShare"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_share"
        android:tint="@color/on_surface_secondary" />

</LinearLayout>
